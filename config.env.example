LISTEN_ADDR="0.0.0.0:8002"
API_KEY="replace_me"
MAX_OUTPUT_CHARS="50000"
EXECUTOR_PATH="./executor"

AUTH_MODE="api_key"
# false keeps /exec and /openapi.{json,yaml} available during migration.
DISABLE_ACTION="false"
PUBLIC_URL="https://mcp.example.com"
AUTH_SERVER_URL="https://mcp.example.com"
OAUTH_CLIENT_ID="chatgpt_mcp"
# Copy the exact redirect URI displayed by ChatGPT when creating the connection.
OAUTH_REDIRECT_URIS="https://chatgpt.com/connector_platform_oauth_redirect"
OAUTH_ALLOWED_SCOPES="tools.read tools.execute"
OAUTH_TOKEN_TTL_SECONDS="3600"
OAUTH_CODE_TTL_SECONDS="600"
OAUTH_USERNAME="replace_me"
OAUTH_PASSWORD="replace_me"
OAUTH_SQLITE_PATH="./oauth.sqlite"

WRITE_ALLOW="/path/to/workspace"
BIND_TCP_ALLOW="9000:9001:9002:9003:9004:9005"
ALLOW_OUTGOING_TCP="true"
BASH_PATH="/bin/bash"
